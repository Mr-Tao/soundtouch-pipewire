post_install() {
  printf '%s\n' \
    'SoundTouch API access remains disabled until each desktop user reviews and accepts the supplemental terms.' \
    'Run these commands as the desktop user, not as root:' \
    '  soundtouch-pipewire eula show' \
    '  soundtouch-pipewire eula accept STPW-SOUNDTOUCH-SUPPLEMENT-1'
}

post_upgrade() {
  printf '%s\n' \
    'Do not treat the package transaction as runtime acceptance or immediately restart an old desktop session.' \
    'In each active desktop session, review any changed installed supplement and follow the public package acceptance contract before starting service-v2:' \
    '  https://github.com/Mr-Tao/soundtouch-pipewire/blob/main/docs/public-package-acceptance-contract.md'
}
