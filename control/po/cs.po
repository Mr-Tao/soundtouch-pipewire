msgid "SoundTouch Volume"
msgstr "Hlasitost SoundTouch"

msgid "View and control SoundTouch receiver volume"
msgstr "Zobrazit a ovládat hlasitost reproduktorů SoundTouch"

msgid "SoundTouch;PipeWire;speaker;volume;mute;"
msgstr "SoundTouch;PipeWire;reproduktor;hlasitost;ztlumit;"

msgid "SoundTouch Volume Indicator"
msgstr "Indikátor hlasitosti SoundTouch"

msgid "Show SoundTouch receiver status and volume controls"
msgstr "Zobrazovat stav a ovládání hlasitosti reproduktorů SoundTouch"

msgid "View and control SoundTouch receiver volume through PipeWire"
msgstr "Zobrazit a ovládat hlasitost reproduktorů SoundTouch přes PipeWire"

msgid "SoundTouch Volume displays confirmed volume, mute, and health for receivers published by the soundtouch-pipewire v2 service."
msgstr "Hlasitost SoundTouch zobrazuje potvrzenou hlasitost, ztlumení a stav reproduktorů zveřejněných službou soundtouch-pipewire v2."

msgid "It provides a StatusNotifierItem and an accessible compact GTK window. Explicit changes use only the matching standard PipeWire Device Route; the service remains the source of confirmed receiver state."
msgstr "Poskytuje StatusNotifierItem a přístupné kompaktní okno GTK. Výslovné změny používají pouze odpovídající standardní PipeWire Device Route; zdrojem potvrzeného stavu reproduktoru zůstává služba."

msgid "Open"
msgstr "Otevřít"

msgid "About"
msgstr "O aplikaci"

msgid "Quit"
msgstr "Ukončit"

msgid "SoundTouch service is unavailable"
msgstr "Služba SoundTouch není dostupná"

msgid "No v2 receivers are currently published."
msgstr "Momentálně nejsou zveřejněny žádné reproduktory v2."

msgid "SoundTouch Receivers"
msgstr "Reproduktory SoundTouch"

msgid "Status and direct PipeWire Device Route control for SoundTouch receivers."
msgstr "Stav a přímé ovládání PipeWire Device Route pro reproduktory SoundTouch."

msgid "Connecting to SoundTouch service…"
msgstr "Připojování ke službě SoundTouch…"

msgid "The SoundTouch service API is incompatible"
msgstr "API služby SoundTouch není kompatibilní"

msgid "SoundTouch discovery is degraded"
msgstr "Vyhledávání SoundTouch je v omezeném stavu"

msgid "Available SoundTouch receivers:"
msgstr "Dostupné reproduktory SoundTouch:"

msgid "controllable"
msgstr "ovladatelných"

msgid "SoundTouch service unavailable"
msgstr "Služba SoundTouch není dostupná"

msgid "The desktop client lost its compatible v2 service connection."
msgstr "Desktopový klient ztratil připojení ke kompatibilní službě v2."

msgid "SoundTouch service restored"
msgstr "Služba SoundTouch byla obnovena"

msgid "The compatible v2 service is available again."
msgstr "Kompatibilní služba v2 je opět dostupná."

msgid "Hardware volume, 0 to 100"
msgstr "Hardwarová hlasitost, 0 až 100"

msgid "Mute"
msgstr "Ztlumit"

msgid "Unavailable"
msgstr "Nedostupné"

msgid "Unknown service state"
msgstr "Neznámý stav služby"

msgid "PipeWire match unavailable"
msgstr "Odpovídající objekt PipeWire není dostupný"

msgid "Busy"
msgstr "Zaneprázdněno"

msgid "Degraded"
msgstr "Omezený stav"

msgid "Online"
msgstr "Online"

msgid "The volume request could not be dispatched."
msgstr "Požadavek na hlasitost se nepodařilo odeslat."

msgid "The receiver did not confirm the final request."
msgstr "Reproduktor nepotvrdil konečný požadavek."
